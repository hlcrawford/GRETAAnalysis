#==============================================================================
# GRETAAnalysis / trackGreta CTK parameter file
#
# Based on the trackMain chat format (see tracking/track.cpp readChatFile).
# Use with pass 2 only:
#   readGreta -f <data> -rootFile out.root
#   trackGreta -i out.root -o tracked.root -trackingChat tracking/greta_readGreta.chat
#   # or parallel:
#   ./scripts/trackGretaParallel.sh -j 8 -i out.root -o tracked.root \
#       -trackingChat tracking/greta_readGreta.chat
#
# Notes for this integration:
#   - Coincidence time grouping is done in readGreta (EB_DIFF_TIME), not dtwin here.
#   - Interaction points are packed in lab frame; GretaTrackingInit() always sets
#     nocrystaltoworldrot (crmat is NOT applied inside trackEvent).
#   - Lines starting with # or ; are comments. Unknown keywords abort the run.
#==============================================================================

# To echo every chat line to stderr, add a line containing only:  echo
# (do not put "echo" in a # comment — older parsers matched the substring)

maxevents 200000000000

################################################
# Do not duplicate mode-2 records on output (trackMain file mode only)
################################################
;nodupmode2

################################################
# Coincidence / time window (trackMain stream mode; harmless for readGreta)
################################################
dtwin 40

################################################
# Target position in mm (x down, y toward GS, z beam); subtracted in tracking
################################################
target_x 0
target_y 0
target_z 0

################################################
# FOM / scattering penalties
################################################
badTheoAngPenalty 0.4
;weightedfom 5.0

################################################
# Double-hit in same segment (0=off, 1=on)
################################################
fixdoublehits 0

################################################
# Energy calibration files (optional; only affect mode-1 style paths in trackMain)
# For readGreta, g2 decomp energies are already in the tree — leave commented unless
# you maintain CCenergy.cal / SEGenergy.cal next to this file.
################################################
CCcal CCenergy.cal
;SEGcal SEGenergy.cal

################################################
# Which FPGA energy to use when calibrating decomp in trackMain
################################################
useCCEnergy
;useSegEnergy

################################################
# Clustering angle vs number of interaction points (degrees)
# Must include at least:  clusterangle 1 <angle>
################################################
clusterangle   1  3
clusterangle   5  10
clusterangle  10  15
clusterangle  30  20

################################################
# Hemisphere xyz offsets [mm] — GRETINA GT only; omit for GRETA unless you have the file
################################################
;xyzoffset xyzOffsets.dat

################################################
# Enabled detector modules (required — otherwise all detectors stay disabled)
################################################
enabled "0-121"

################################################
# Tracking strategies per ndet (option 5 = jump, with g/t pattern in 4th field)
# Realistic CPU-friendly settings from trackMain defaults:
################################################
trackingstrategy 1 0
trackingstrategy 2 0
trackingstrategy 3 0
trackingstrategy 4 0
trackingstrategy 5 0
trackingstrategy 6 5 ggtttt
trackingstrategy 7 5 gggtttt
trackingstrategy 8 5 gggttttt

fomjump 1.0
fomgoodenough 1.0

################################################
# Untracked (monster) clusters — recluster pass
################################################
recluster1   0.05  0.1  3 20  0.90
splitclusters1 0.2 0.3  4 16 100
untracked_fom_kickout 0.1

################################################
# Tracked clusters that still look wrong (usually off for speed)
################################################
recluster2  0.10  1.2   3  10  0.90
;splitclusters2  0.2  0.8  3  16 2000 0.5
;combineclusters 0.1 0.3  8   27

################################################
# Single-hit matching (optional)
################################################
singlesfom 0.8
;matchmaker 0.05 10

itterations 1
;nprint 50

################################################
# Lab-frame / pre-rotated hit coordinates (also forced on in GretaTrackingInit)
################################################
nocrystaltoworldrot

################################################
# Single-hit depth penalty table (energy MeV vs range cm from crystal surface)
# Copied from trackMain GRETA example — adjust distToCrystal for your target distance
################################################
singlehitmaxdepth 18 1.85 18.5 1.0
0.000   0.59
0.080   0.59
0.100   0.62
0.150   1.38
0.200   2.07
0.300   3.05
0.400   3.69
0.500   4.19
0.600   4.62
0.800   5.36
1.000   6.01
1.250   6.75
1.500   7.40
2.000   8.43
3.000   9.77
4.000  10.52
5.000  10.91
16.383 27.41

################################################
# Pair production search (enable for high-energy data; comment out to save CPU)
################################################
;ppfind
;ppemin     1.022
;ppde       0.010
;ppeflash   2.0
;ppmaxdist  10.0
;ppdflash   2.0
